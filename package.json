{
  "name": "recall-mint",
  "version": "0.1.0",
  "private": true,
  "description": "Spaced-repetition learning card platform with FSRS + AI OCR",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
