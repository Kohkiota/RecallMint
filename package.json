    "audit": "node scripts/audit-gate.mjs",
    "test": "vitest run",
    "test:iso": "vitest run --config vitest.integration-pg.config.ts",
    "test:contract": "vitest run tests/contract",
    "prepare": "lefthook install",
    "test:watch": "vitest",
