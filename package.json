    "@google/genai": "2.13.0",
    "@hyzyla/pdfium": "2.1.13",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.8",
    "aws4fetch": "1.0.20",
    "browser-image-compression": "2.0.2",
    "bufferutil": "4.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
