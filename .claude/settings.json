{
  "permissions": {
    "allow": [],
    "deny": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(git config --global:*)",
      "Bash(git push:*)",
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)",
      "Bash(git remote remove:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh release delete:*)",
      "Bash(git commit --no-verify)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit * --no-verify)",
      "Bash(git commit -n)",
      "Bash(git commit -n *)",
      "Bash(git commit * -n)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "autoUpdatesChannel": "stable",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-review.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/detect-leaked-toolcall.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/discord-notify.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": ".claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  }
}
