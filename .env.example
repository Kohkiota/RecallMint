# ============================================
# .env.example
# ============================================
# このファイルは Git に含める (値は入れない)
# 実際のキーは .env.local に記載 (.gitignore 済)
# ============================================

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL — Supabase Transaction pooler を想定)
# driver: postgres.js (`prepare: false` で PgBouncer transaction mode に対応、
# lib/db/index.ts 参照)。 Neon でも同 connection string 形式で動くが、 既定の運用
# 想定は Supabase。
# RLS-P1: app runtime は least-privilege role (recallmint_app) で接続する。
# :6543 の transaction pooler port・recallmint_app role の connection string。
DATABASE_URL_APP=postgresql://...
# owner (postgres) 接続。 migration/operator (drizzle-kit・grants 付与・
# scripts/ 配下の one-shot script) 専用、 app runtime からは読まない。
# 値は空のまま — 実行時に OT が供給する。
DATABASE_URL_ADMIN=

# Clerk (test keys only)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_WEBHOOK_SECRET=whsec_...

# Stripe (env-aware: production = live keys / preview+local = test keys)
# - local / preview: STRIPE_SECRET_KEY=rk_test_* (Restricted Key 推奨)、 PUBLISHABLE=pk_test_*
# - production (Vercel Production scope): STRIPE_SECRET_KEY=rk_live_* / sk_live_*、 PUBLISHABLE=pk_live_*
# Test Clock 検証スクリプト専用(sk_test_ = test mode 全権限。アプリ runtime は上の rk_test_ を維持)
STRIPE_TEST_CLOCK_SECRET_KEY=sk_test_...
# Restricted key の権限設定は README.md / docs/ を参照
STRIPE_SECRET_KEY=rk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STANDARD_MONTHLY=price_...
STRIPE_PRICE_STANDARD_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...

# Google Gemini (Tier 1 + Prepay 切替済)
# Daily limit は MVP 段階のソフト上限、Tier 2 達成で見直し
GEMINI_API_KEY=...
GEMINI_DAILY_LIMIT=1000

# OCR デバッグログ: 1 のとき Gemini の raw response を Vercel Function Logs に
# 出力する (event=ocr.gemini.response、先頭 50000 文字に truncate)。OCR 抽出結果の
# 調査用。staging でのみ一時的に有効化し、production 本番には設定しない
# (log 肥大 / 情報露出回避)。未設定 = 出力なし。
# production では LOG_GATE_ALLOW_PROD=1 も併せて要する 2 段 gate (lib/env/log-gate.ts)。
OCR_DEBUG_LOG=

# bulk review 診断ログ: 1 のとき /api/review-events/bulk の tx_failed log に bind params
# 全体を出力する (event=review_events.bulk.tx_failed の fullParams、lib/db/serialize-db-error.ts)。
# cards UPDATE rollback の native error 調査用。未設定 / "1" 以外 = params は要約のみ
# (count / 型分布 / anomaly / card_id 抽出) で full params は出さない。
# staging (Vercel Preview) でのみ一時的に有効化し、production 本番には設定しない
# (PII / log 肥大回避)。診断完了後は Preview からも外す一時 flag。
# production では LOG_GATE_ALLOW_PROD=1 も併せて要する 2 段 gate (lib/env/log-gate.ts)。
BULK_FULL_PARAMS_LOG=

# 2 段 gate (audit §10.3 (b) #5): production (VERCEL_ENV=production) で
# OCR_DEBUG_LOG / BULK_FULL_PARAMS_LOG 等の debug log flag を effective に
# するための **第 2 段の承認 flag**。 production で env 直 = '1' のみ
# (片方欠落) では log は出ない (lib/env/log-gate.ts、 isLogGateOpen)。
# 非 production (preview / dev / undefined) では本 flag は不要 (no-op)。
# production で raw payload を log へ流すのは事故時 PII 露出 / log 肥大
# リスクがあるため、 OT が一時的に "1" を立て、 調査完了で必ず外す運用。
LOG_GATE_ALLOW_PROD=

# 構造化 logger (lib/logger.ts emit() 内 level filter、 audit 軽微 1 / Y-2 T-C3)
# production (VERCEL_ENV=production) 既定 = warn 以上のみ出力 (info 抑止 =
# flush.kick 等の常時 info を console から削減)。 非 production 既定 = info 以上
# (全出力)。 明示値 = 'info' / 'warn' / 'error' で env tier に関係なく上書き可
# (debug 経路)。 不正値 / 空 = 既定 tier に fallback。
LOG_LEVEL=

# Cloudflare R2 (画像フェーズ A: card 添付画像を非公開 bucket に presigned 直 PUT)
# bucket: mcq-platform、Object Read & Write 権限の API token
# lib/storage/r2.ts が fail-fast で必須にするのは下記 4 変数のみ。
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=mcq-platform
# R2_PUBLIC_URL は画像フェーズ A では未使用 (非公開 bucket + presigned GET で表示するため)。
# コードから参照されず fail-fast 対象外。将来 public 配信を採る場合のみ利用。
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# Operational notification (Discord incoming webhook、 アプリのエラー通知用)
# lib/ops.ts の notifyOps が使用 (webhook handler 失敗 / 削除 failure 等)
# OT が Discord で channel 作成 → incoming webhook URL 発行
# 未設定環境 (ローカル dev / preview) では notifyOps は no-op
OPS_DISCORD_WEBHOOK_URL=

# Claude Code session notification (Discord incoming webhook、 OPS とは別 channel)
# .claude/hooks/discord-notify.py が Stop hook で使用、 セッション完了時の
# last assistant message を投稿。 channel 混線を避けるため OPS と分離。
# 未設定環境では hook は silent skip
CLAUDE_CODE_DISCORD_WEBHOOK_URL=