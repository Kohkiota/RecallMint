{
  "name": "OT Microbiz Dev Container",
  "image": "mcr.microsoft.com/playwright:v1.58.2",
  "shutdownAction": "stopContainer",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "vscode",
      "webPort": "6080",
      "vncPort": "5901",
      "installUser": "false"
    }
  },

  "remoteUser": "root",
  "containerUser": "root",

  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/root/.claude,type=volume",
    "source=claude-code-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=${localEnv:HOME}/.gitconfig,target=/root/.gitconfig,type=bind,readonly"
  ],

  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/root/.claude",
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "IS_SANDBOX": "1"
  },

  "forwardPorts": [3000, 5173, 8000, 6080, 4983],
  "portsAttributes": {
    "3000": { "label": "Next.js / generic", "onAutoForward": "notify" },
    "5173": { "label": "Vite", "onAutoForward": "notify" },
    "8000": { "label": "FastAPI / Django", "onAutoForward": "silent" },
    "6080": { "label": "noVNC (browser debug)", "onAutoForward": "silent" },
    "4983": { "label": "Drizzle Studio", "onAutoForward": "silent" }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-playwright.playwright"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true
      }
    }
  },

  "remoteEnv": {
    "PNPM_HOME": "/root/.local/share/pnpm",
    "PATH": "/root/.local/share/pnpm:/root/.npm-global/bin:${containerEnv:PATH}"
  }
}
